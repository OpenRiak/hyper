%%
%% This is a complete replacement of GA's rebar.config - DO NOT MERGE!
%%

{minimum_otp_vsn, "24"}.

{erl_opts, [
    warn_bif_clash,
    warn_export_all,
    warn_export_vars,
    warn_obsolete_guard,
    warn_unused_import
]}.

{erl_first_files, [
    "src/hyper_register.erl"    % behavior
]}.

{profiles, [
    {check, [
        {dialyzer, [
            {warnings, [
                error_handling,
                race_conditions,
                unknown,
                unmatched_returns
            ]}
        ]},
        {erl_opts, [
            debug_info,
            warnings_as_errors,
            {d, 'BUILD_CHECK'}
        ]},
        {xref_checks, [
            deprecated_function_calls,
            deprecated_functions,
            locals_not_used,
            undefined_function_calls,
            undefined_functions
        ]}
    ]},
    {docs, [
        {edoc_opts, [
            {preprocess, true},
            {macros, [
                {'EDOC', true},
                {'BUILD_DOCS', true}
            ]}
        ]}
    ]},
    {prod, [
        {erl_opts, [
            warnings_as_errors,
            {d, 'BUILD_PROD'}
        ]}
    ]},
    {test, [
        {cover_enabled, true},
        {erl_opts, [
            debug_info,
            nowarn_deprecated_function,
            nowarn_export_all,
            nowarn_unused_function,
            nowarn_unused_import,   % EQC
            warnings_as_errors,
            {d, 'BUILD_TEST'}
        ]},
        {dialyzer, [
            % Ensure dialyzer sees test-only dependencies without adding them
            % to hyper.app.src.
            % `rebar3 as check, test do dialyzer` still reports warnings, but
            % not for undefined functions.
            {plt_extra_apps, [
                basho_stats,
                eunit,
                proper
            ]}
        ]},
        {deps, [
            proper,
            {basho_stats,
                {git, "https://github.com/basho/basho_stats.git",
                    {branch, "develop"}}}
        ]}
    ]},
    {gha, [
        {erl_opts, [
            {d, 'GITHUBEXCLUDE'}
        ]}
    ]},
    {validate, [
        {erl_opts, [
            strong_validation,
            no_auto_import,
            warn_bif_clash,
            warn_deprecated_function,
            warn_deprecated_type,
            warn_export_all,
            warn_export_vars,
            warn_missing_spec,
            warn_missing_spec_all,
            warn_obsolete_guard,
            warn_shadow_vars,
            warn_untyped_record,
            warn_unused_function,
            warn_unused_import,
            warn_unused_record,
            warn_unused_vars,
            {d, 'BUILD_VALIDATE'}
        ]}
    ]}
]}.
