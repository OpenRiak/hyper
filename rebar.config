%% -*- mode: erlang; erlang-indent-level: 4; indent-tabs-mode: nil -*-
{xref_checks, [undefined_function_calls,
               undefined_functions,
               locals_not_used,
               deprecated_function_calls,
               deprecated_functions]}.
{cover_enabled, true}.
{deps, [{basho_stats, {git, "https://github.com/OpenRiak/basho_stats.git", {branch, "openriak-3.6"}}}]}.

{profiles, [
    {test, [{deps, [{proper, {git, "https://github.com/OpenRiak/proper.git", {branch, "openriak-3.6"}}}]}]},
    {gha, [{erl_opts, [{d, 'GITHUBEXCLUDE'}]}]}
]}.
